\@writefile{toc}{\contentsline {section}{\numberline {I}Introduction}{1}{section.1}\protected@file@percent }
\newlabel{sec:introduction}{{I}{1}{Introduction}{section.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Omni-Shield system architecture. All AI inference runs on the local GPU inside a single-device boundary (outer box) --- no document leaves the device at any point. The FastAPI backend orchestrates four models within a 3.31\,GB VRAM peak budget. Every redaction is anchored to the local Ganache Ethereum node and written to an \texttt  {.audit.json} sidecar.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:architecture}{{1}{2}{Omni-Shield system architecture. All AI inference runs on the local GPU inside a single-device boundary (outer box) --- no document leaves the device at any point. The FastAPI backend orchestrates four models within a 3.31\,GB VRAM peak budget. Every redaction is anchored to the local Ganache Ethereum node and written to an \texttt {.audit.json} sidecar}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The nine-agent image redaction pipeline with mean latency per agent. The LayoutAgent (orange) invokes the fine-tuned Qwen2-VL-2B VLM and accounts for 46\% of total pipeline time (4.79\,s of 10.42\,s mean). All agents communicate exclusively through the shared \texttt  {AgentState} object (dashed box), enabling ablation of any agent without pipeline redesign.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{2}{The nine-agent image redaction pipeline with mean latency per agent. The LayoutAgent (orange) invokes the fine-tuned Qwen2-VL-2B VLM and accounts for 46\% of total pipeline time (4.79\,s of 10.42\,s mean). All agents communicate exclusively through the shared \texttt {AgentState} object (dashed box), enabling ablation of any agent without pipeline redesign}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-agent latency breakdown for image redaction (warm models). LayoutAgent (VLM inference) dominates at 4.79\,s (46\% of total). OCRAgent and CriticAgent together account for a further 44\%.}}{2}{figure.3}\protected@file@percent }
\newlabel{fig:timings}{{3}{2}{Per-agent latency breakdown for image redaction (warm models). LayoutAgent (VLM inference) dominates at 4.79\,s (46\% of total). OCRAgent and CriticAgent together account for a further 44\%}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces PII category confusion matrix across 150 test documents. False negatives (655) dominate over false positives (175), indicating that recall, not precision, is the primary failure mode. Date of Birth exhibits the highest false positive rate (61 FP against 65 TP).}}{2}{figure.4}\protected@file@percent }
\newlabel{fig:confusion}{{4}{2}{PII category confusion matrix across 150 test documents. False negatives (655) dominate over false positives (175), indicating that recall, not precision, is the primary failure mode. Date of Birth exhibits the highest false positive rate (61 FP against 65 TP)}{figure.4}{}}
