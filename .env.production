# ─────────────────────────────────────────────────────────────────────────────
# OMNI-SHIELD production environment template
# Copy to .env and fill in real values. NEVER commit this file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────
# Comma-separated SHA-256 hashes of valid API keys.
# Generate:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Hash:      python3 -c "import hashlib; print(hashlib.sha256(b'KEY').hexdigest())"
OMNI_API_KEYS=sha256_hash_of_your_api_key_here

# ── Blockchain ────────────────────────────────────────────────────────────────
# Polygon Amoy testnet (free MATIC: https://faucet.polygon.technology)
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# Polygon mainnet: BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
# Local Ganache:   BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545

# Wallet private key for contract transactions — NEVER share this
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_here

# ── Redis (async job queue) ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Model settings ────────────────────────────────────────────────────────────
OMNI_SKIP_ADAPTER=0

# ── File retention ────────────────────────────────────────────────────────────
FILE_RETENTION_HOURS=24
